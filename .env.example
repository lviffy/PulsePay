# Node >=22.13, pnpm 12.14.0. Application scripts load the root .env automatically.
NODE_ENV=development
PORT=3000
PULSEPAY_APP_URL=http://localhost:3000
# Required: random secret of at least 32 characters. Used by merchant login and x-api-key.
PULSEPAY_API_SECRET=
# EVM fixture mutations are disabled unless explicitly enabled. They never move funds.
PULSEPAY_DEMO_MODE=false
# Local default is .pulsepay. Production requires an ABSOLUTE path on a persistent volume.
PULSEPAY_STATE_DIRECTORY=

# Whitechain SDK and authenticated onchain invoice reads
WHITECHAIN_CHAIN_ID=1874
WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io
WHITECHAIN_USDT_ADDRESS=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7
WHITECHAIN_MERCHANT_HUB_ADDRESS=

# Server-side Uniswap Trading API quotes. Does not bridge into Whitechain.
UNISWAP_API_KEY=
UNISWAP_CHAIN_ID=1301
# Treasury adapter targets Unichain Sepolia independently of Whitechain invoices.
UNISWAP_RPC_URL=https://sepolia.unichain.org
UNISWAP_POOL_MANAGER=0x00B036bf97F650eEa2f656606A6C4F07449c25f5
UNISWAP_TREASURY_HOOK_ADDRESS=
# Required only when preparing a new TreasuryGuardHook deployment.
DEPLOYER_ADDRESS=
TREASURY_INPUT_TOKEN=
# Raw units of TREASURY_INPUT_TOKEN, e.g. 1000000000 means 1000 of a 6-decimal token.
TREASURY_MAX_INPUT_UNITS=

# Native Hedera receipt payments. Use accounts and topic submit keys that you control.
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_MERCHANT_ACCOUNT_ID=
HEDERA_BUYER_ACCOUNT_ID=
# Leave blank for unsigned wallet preparation; a valid key enables real automatic payments.
HEDERA_BUYER_KEY=
HEDERA_AUDIT_TOPIC_ID=
HEDERA_SERVICE_PRICE_TINYBARS=1
HEDERA_MAX_PAYMENT_TINYBARS=1
HEDERA_DAILY_BUDGET_TINYBARS=10
HEDERA_MAX_FEE_TINYBARS=1000000
HEDERA_AUDIT_MAX_FEE_TINYBARS=2000000

# Next.js merchant UI (http://localhost:3100). Public addresses only; no browser signing keys.
PULSEPAY_MERCHANT_ADDRESS=
PULSEPAY_MERCHANT_NAME=Merchant console
PULSEPAY_WEB_URL=http://localhost:3100
# Earliest hub event block. The UI reads explicit 20,000-block windows, in 2,000-block RPC chunks.
WHITECHAIN_DEPLOYMENT_BLOCK=0
# Actual paid API origin, separate from the Next.js app. Used for live x402 discovery.
PULSEPAY_SERVICE_URL=http://localhost:3000
