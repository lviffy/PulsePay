# ==========================================
# PulsePay Environment Configuration
# ==========================================

# Core Application & API
NODE_ENV=development
PORT=3000
PULSEPAY_APP_URL=http://localhost:3000
PULSEPAY_API_URL=http://localhost:3001
PULSEPAY_API_SECRET=dev_secret_key_change_in_production
DATABASE_URL=file:./dev.db

# ==========================================
# Track 1: Whitechain (Sepolia Testnet)
# ==========================================
WHITECHAIN_CHAIN_ID=1874
WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io
WHITECHAIN_EXPLORER_URL=https://explorer.testnet.whitechain.io
# Official ETHGlobal Whitechain USDT Token (Mandatory)
WHITECHAIN_USDT_ADDRESS=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7
# Deployed PulsePayMerchantHub Contract Address
WHITECHAIN_MERCHANT_HUB_ADDRESS=

# ==========================================
# Track 2: Uniswap Protocol & v4 Treasury
# ==========================================
# Trading API Key for Pay-With-Any-Token Routing
UNISWAP_API_KEY=
# Uniswap v4 Testnet (Default: Unichain Sepolia)
UNISWAP_CHAIN_ID=1301
UNISWAP_RPC_URL=https://sepolia.unichain.org
UNISWAP_POOL_MANAGER=
UNISWAP_POSITION_MANAGER=
UNISWAP_UNIVERSAL_ROUTER=
# Deployed TreasuryGuardHook Address
UNISWAP_TREASURY_HOOK_ADDRESS=

# ==========================================
# Track 3: Hedera (x402 & HCS Audit)
# ==========================================
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.xxxxx
HEDERA_OPERATOR_KEY=302e020100300506032b657004220420...
# Merchant HCS Topic ID for Consensus Audit Trail
HEDERA_AUDIT_TOPIC_ID=0.0.xxxxx
# x402 Facilitator Endpoint
HEDERA_X402_FACILITATOR_URL=https://testnet.facilitator.x402.org

