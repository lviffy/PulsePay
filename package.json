{
  "name": "pulsepay-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "PulsePay: The unified onchain payment & treasury stack for businesses, human customers, and AI agents",
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/dev.mjs",
    "lint": "turbo run lint && eslint scripts eslint.config.mjs",
    "test": "pnpm test:unit && pnpm test:contracts",
    "demo": "pnpm --filter pulsepay-sdk-demo start",
    "demo:web": "pnpm --filter pulsepay-sdk-demo web",
    "build:hedera": "pnpm build",
    "test:hedera": "pnpm build && pnpm --filter @pulsepay/adapter-hedera test && pnpm --filter @pulsepay/sdk-server test",
    "contracts:whitechain:build": "node scripts/forge.mjs whitechain build",
    "contracts:whitechain:test": "node scripts/forge.mjs whitechain test",
    "contracts:uniswap:build": "node scripts/forge.mjs uniswap-v4 build",
    "contracts:uniswap:test": "node scripts/forge.mjs uniswap-v4 test",
    "test:unit": "turbo run test",
    "test:contracts": "pnpm contracts:whitechain:test && pnpm contracts:uniswap:test",
    "verify": "pnpm lint && pnpm build && pnpm test && pnpm audit --audit-level=high",
    "dev:web": "node scripts/dev.mjs --web-only",
    "dev:api": "node scripts/run-app.mjs demo-store --watch",
    "test:dev": "node --test scripts/dev.test.mjs"
  },
  "keywords": [
    "pulsepay",
    "whitechain",
    "uniswap",
    "hedera",
    "x402",
    "agentic-payments",
    "subscriptions"
  ],
  "author": "PulsePay Team",
  "license": "MIT",
  "devDependencies": {
    "solc": "0.8.26",
    "turbo": "^2.4.0",
    "typescript": "^5.7.3",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@12.14.0",
  "overrides": {
    "ws@>=8.0.0 <8.21.0": "^8.21.0",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1",
    "tmp@<0.2.6": "^0.2.6"
  }
}
